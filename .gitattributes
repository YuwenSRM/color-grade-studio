# Keep repository text consistent across platforms.
* text=auto eol=lf

# Windows launchers require CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Do not apply text conversion to binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.avif binary
*.cube binary
*.3dl binary
