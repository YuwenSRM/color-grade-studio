# Copy this file to .env. Values in the system environment take precedence.
# Do not commit .env or put credentials in browser-side code.

# Local HTTP server. HOST accepts only 127.0.0.1 or localhost.
PORT=4173
HOST=127.0.0.1

# Optional SQLite executable path. Leave empty to use tools/sqlite3.exe or PATH.
SQLITE_PATH=

# Used only to create the first administrator when the database has no users.
# Use a unique password with at least 8 characters, then restart the server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional licensed provider credentials. Obtain these from the relevant provider.
UNSPLASH_ACCESS_KEY=
VCG_SEARCH_URL=
VCG_API_TOKEN=
